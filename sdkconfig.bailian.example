#
# 阿里云百炼应用配置示例
# Aliyun Bailian Application Configuration Example
#
# 使用方法 / Usage:
# 1. 复制本文件为 sdkconfig.defaults
#    Copy this file to sdkconfig.defaults
# 2. 修改 BAILIAN_API_KEY 和 BAILIAN_APP_ID 为你的实际值
#    Replace BAILIAN_API_KEY and BAILIAN_APP_ID with your actual values
# 3. 运行 idf.py build
#    Run idf.py build
#

#
# Xiaozhi Assistant 小智助手配置
#
# 协议类型选择 / Protocol Type Selection
CONFIG_XIAOZHI_PROTOCOL_BAILIAN=y
# CONFIG_XIAOZHI_PROTOCOL_OTA is not set
# CONFIG_XIAOZHI_PROTOCOL_CUSTOM is not set

#
# Aliyun Bailian Application Configuration 阿里云百炼应用配置
#
# 你的百炼 API Key (从 https://dashscope.console.aliyun.com/ 获取)
# Your Bailian API Key (get it from https://dashscope.console.aliyun.com/)
CONFIG_BAILIAN_API_KEY="sk-3c373c69431947e781a68fd9dad86ccd"

# 你的百炼应用 ID (从 https://bailian.console.aliyun.com/ 创建应用后获取)
# Your Bailian Application ID (create app at https://bailian.console.aliyun.com/)
CONFIG_BAILIAN_APP_ID="c897a3567b374b839bb0b1974aebc548"

# 启用流式输出 / Enable Streaming Output
CONFIG_BAILIAN_USE_STREAMING=y

# 会话超时时间(秒) / Session Timeout (seconds)
CONFIG_BAILIAN_SESSION_TIMEOUT=100

#
# 常用开发板配置示例 / Common Board Configuration Examples
#

# 面包板 WiFi 版本 / Breadboard WiFi Version
# CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI=y

# 立创实战派 ESP32-S3 / LiChuang ESP32-S3
# CONFIG_BOARD_TYPE_LICHUANG_DEV_S3=y

# ESP32-S3-BOX-3
# CONFIG_BOARD_TYPE_ESP_BOX_3=y

# M5Stack CoreS3
# CONFIG_BOARD_TYPE_M5STACK_CORE_S3=y

# M5Stack AtomS3R + Echo Base
# CONFIG_BOARD_TYPE_M5STACK_ATOM_S3R_ECHO_BASE=y

#
# WiFi 配置建议 / WiFi Configuration (Optional)
#
# 如果你想在代码中预设 WiFi 信息,可以添加:
# If you want to preset WiFi credentials in code, add:
CONFIG_XIAOZHI_WIFI_SSID="三花淡奶"
CONFIG_XIAOZHI_WIFI_PASSWORD="haiwei1002"

#
# 语言选择 / Language Selection
#
CONFIG_LANGUAGE_ZH_CN=y
# CONFIG_LANGUAGE_EN_US is not set
# CONFIG_LANGUAGE_JA_JP is not set

#
# ESP32-S3 特定配置 / ESP32-S3 Specific Configuration
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM 配置 / PSRAM Configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

#
# 语音识别配置 / Speech Recognition Configuration
#
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

#
# 注意事项 / Notes
#
# 1. 请确保你的 API Key 和 App ID 是有效的
#    Make sure your API Key and App ID are valid
#
# 2. 百炼应用需要配置为支持语音输入和语音输出
#    Bailian application should be configured to support audio input and output
#
# 3. 本配置跳过 xiaozhi.me 的配置步骤,直接使用阿里云百炼 API
#    This configuration skips xiaozhi.me and uses Aliyun Bailian API directly
#
# 4. 如果遇到连接问题,请检查:
#    If you encounter connection issues, check:
#    - API Key 是否正确 / API Key is correct
#    - App ID 是否正确 / App ID is correct  
#    - 网络连接是否正常 / Network connection is working
#    - 阿里云账户是否有足够的额度 / Aliyun account has sufficient quota
#
